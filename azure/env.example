# Copy to env.local (gitignored) and fill with RHDP Azure Blank OPEN values.
#   cp env.example env.local
#
# RHDP: https://demo.redhat.com → Services → Azure Blank OPEN

# Azure identity (service principal OR use: az login)
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
# Optional service principal (if not using interactive az login):
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# Resource group — often pre-created in OPEN; otherwise script creates it
AZURE_RESOURCE_GROUP=fl-gold-rg
AZURE_LOCATION=eastus

# Names
IMAGE_NAME=fl-rhel-gold
VM_NAME=fl-rhel-gold-poc
STORAGE_ACCOUNT=          # leave empty to auto-create flgoldXXXX
STORAGE_CONTAINER=vhds

# VM size (OPEN quotas vary; Standard_B2s is a safe default)
VM_SIZE=Standard_B2s

# SSH (same key as AWS PoC is fine)
SSH_PRIVATE_KEY=~/.ssh/fl-gold-poc.pem
SSH_PUBLIC_KEY=           # leave empty to derive from private key
ADMIN_USER=fladmin1

# Your public IP as x.x.x.x/32 (auto-detected if empty)
SSH_CIDR=

# Path to local .vhd after download from S3 (set by upload-vhd.sh if omitted)
VHD_PATH=

# Password for fladmin PoC (cloud-init custom-data). Letters/numbers only.
GOLD_ADMIN_PASSWORD=FlGoldDemo2026
