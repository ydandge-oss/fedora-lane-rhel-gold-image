# Copy to env.local (gitignored) and fill in with RHDP AWS Blank OPEN values.
#   cp env.example env.local
#
# RHDP: https://demo.redhat.com → Services → AWS Blank OPEN → copy keys

# From RHDP service overview (often us-east-2)
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

INSTANCE_TYPE=t3.medium
# Builder for Image Builder compose needs more disk/CPU:
BUILDER_INSTANCE_TYPE=t3.xlarge
BUILDER_VOLUME_GB=80

NAME_TAG=fl-rhel-gold-poc

# Create an EC2 key pair in the RHDP account first, or set CREATE_KEY_PAIR=yes
KEY_NAME=fl-gold-poc
CREATE_KEY_PAIR=yes
SSH_PRIVATE_KEY=~/.ssh/fl-gold-poc.pem

# RHEL login user on Marketplace AMI
SSH_USER=ec2-user

# Your public IP as x.x.x.x/32 (curl -4 ifconfig.me)
SSH_CIDR=

# Leave empty to auto-pick latest RHEL 9/10 Hourly AMI (Red Hat owner 309956199498)
# Used as the *builder* base OS for Image Builder (and for cloud-init fast PoC).
AMI_ID=

# After compose-on-builder.sh succeeds, gold AMI id is written here automatically:
GOLD_AMI_ID=

# Password for fladmin1/fladmin2 on gold-AMI PoC launch (cloud-init). Needed for sudo.
# Do not commit env.local. Change this for demos.
GOLD_ADMIN_PASSWORD='FlGoldDemo2026'

# S3 bucket for Image Builder AMI upload (auto-created if empty)
AWS_BUCKET=
AWS_AMI_NAME=fl-rhel-gold

# Optional
SUBNET_ID=
VPC_ID=
